{
  "name": "ai-capstone",
  "version": "1.0.0",
  "private": true,
  "description": "AI-assisted Software Engineering Internship capstone project",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test test/settings.test.js test/stream.test.js",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:unit && npm run test:e2e"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "openai": "^7.9.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "supertest": "^7.1.4",
    "@playwright/test": "^1.56.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "jsdom": "^26.1.0",
    "vitest": "^3.2.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  }
}
